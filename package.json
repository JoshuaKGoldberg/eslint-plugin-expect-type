{
	"name": "eslint-plugin-expect-type",
	"version": "0.7.0",
	"description": "ESLint plugin with ^? Twoslash, $ExpectError, and $ExpectType type assertions. 🧩",
	"keywords": [
		"$ExpectError",
		"$ExpectType",
		"$ExpectTypeSnapshot",
		"Assert",
		"Expect",
		"Snapshot",
		"Type",
		"^?",
		"config",
		"d.ts",
		"dtslint",
		"eslint",
		"plugin",
		"rule",
		"ts",
		"tslint",
		"twoslash",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/eslint-plugin-expect-type.git"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "JoshuaKGoldberg",
		"email": "npm@joshuakgoldberg.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./configs/recommended": {
			"import": {
				"types": "./dist/configs/recommended.d.mts",
				"default": "./dist/configs/recommended.mjs"
			},
			"require": {
				"types": "./dist/configs/recommended.d.cts",
				"default": "./dist/configs/recommended.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "tsdown",
		"build:docs": "eslint-doc-generator",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:docs": "eslint-doc-generator --check",
		"lint:knip": "knip",
		"lint:packages": "pnpm dedupe --check",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"test": "vitest",
		"tsc": "tsc"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"dependencies": {
		"@typescript-eslint/utils": "^6.10.0 || ^7.0.1 || ^8",
		"cached-factory": "^0.3.0",
		"fs-extra": "^11.4.0",
		"get-tsconfig": "^4.14.3"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "8.0.3",
		"@release-it/conventional-changelog": "^12.0.2",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "26.6.6",
		"@typescript-eslint/rule-tester": "^8.73.0",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.28",
		"console-fail-test": "0.10.0",
		"create-typescript-app": "2.75.0",
		"cspell": "10.5.1",
		"dedent": "^1.7.2",
		"eslint": "10.15.0",
		"eslint-doc-generator": "^3.7.1",
		"eslint-plugin-eslint-plugin": "7.6.2",
		"eslint-plugin-jsdoc": "65.4.11",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-package-json": "1.14.0",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-regexp": "3.3.3",
		"eslint-plugin-yml": "3.10.0",
		"husky": "9.1.7",
		"knip": "6.45.1",
		"lint-staged": "17.6.1",
		"prettier": "^3.10.1",
		"prettier-plugin-curly": "0.4.2",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.5",
		"prettier-plugin-sh": "0.20.2",
		"release-it": "21.1.2",
		"tsdown": "0.23.7",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"typescript54": "npm:typescript@5.4.5",
		"vitest": "5.1.0"
	},
	"peerDependencies": {
		"@typescript-eslint/parser": ">=6",
		"eslint": ">=7",
		"typescript": ">=4"
	},
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"publishConfig": {
		"provenance": true
	}
}
