{
	"compilerOptions": {
		"lib": ["es2017"],
		"module": "commonjs",

		// Deprecated as of TypeScript 6, which reports an options diagnostic in this file
		// Testing that it doesn't get treated as an error in linted files
		"moduleResolution": "node",

		// Testing that these don't get passed through as issues
		// https://github.com/ibezkrovnyi/eslint-plugin-expect-type/issues/16
		"noUnusedLocals": true,
		"noUnusedParameters": true,

		"skipLibCheck": true,
		"strict": true,
		"target": "es2017"
	},
	"files": [
		"file.ts",
		"package/foo.ts",
		"versioned-errors.ts",
		"versioned-no-errors.ts",
		"versioned-snapshot.ts"
	]
}
